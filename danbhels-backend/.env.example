PORT=5000
FRONTEND_URL=http://localhost:5173

# Copy the values from the Clever Cloud MySQL add-on.
MYSQL_ADDON_HOST=your-clever-mysql-host
MYSQL_ADDON_DB=your-database-name
MYSQL_ADDON_USER=your-database-user
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=your-database-password
MYSQL_ADDON_URI=mysql://user:password@host:3306/database
